# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=udai

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password    # 16-char App Password from myaccount.google.com/apppasswords

# MSG91 WhatsApp
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_NUMBER=91XXXXXXXXXX              # Your MSG91 integrated WhatsApp number (no + sign)
