Options -MultiViews

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories directly. This prevents JS/CSS assets from
  # being rewritten to index.html, which causes MIME type errors and a blank app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite built static assets to index.html.
  RewriteRule ^assets/ - [L]
  RewriteRule ^images/ - [L]

  # React Router fallback for direct refreshes like /contact or /about.
  RewriteRule ^ index.html [L]
</IfModule>
