NODE_ENV=development
PORT=8080

# Comma-separated origins allowed to call this service.
# For MSG91 server-to-server calls, CORS is not normally used, but keep this
# strict if you also test from a browser.
CORS_ORIGIN=http://localhost:3000

# Send the same value in the chatbot API Node header:
# x-api-key: your-long-random-secret
WEBHOOK_API_KEY=replace_with_a_long_random_secret

# Database
DB_DRIVER=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/msg91_bridge
